# ── GOAT Network ──────────────────────────────────────────────────────────
# Mainnet by default: that is where the contracts and the real stablecoin live.
# GOAT_CHAIN_ID is part of the EIP-712 domain every payment authorization is signed under, so a
# value that disagrees with GOAT_RPC_URL produces signatures that are valid for the wrong chain
# and fail with a misleading "invalid signature". @tiagoh/goat now checks the two against each
# other at startup and refuses to sign on a mismatch.
GOAT_CHAIN_ID=2345
GOAT_RPC_URL=https://rpc.goat.network
GOAT_EXPLORER_URL=https://explorer.goat.network
# Testnet3 (has its own vars so pointing at it is deliberate, never a side effect):
# GOAT_TESTNET_CHAIN_ID=48816
# GOAT_TESTNET_RPC_URL=https://rpc.testnet3.goat.network

# ── Payment token (x402) ──────────────────────────────────────────────────
# GOAT mainnet USDC.e is a real Circle FiatTokenV2: transferWithAuthorization (EIP-3009) and
# permit (EIP-2612) both work, so the canonical x402 `exact` scheme runs natively and tiagoh
# needs no external facilitator.
TIAGOH_PAYMENT_TOKEN=0x3022b87ac063DE95b1570F46f5e470F8B53112D8
# Optional: an external x402 facilitator. Unset is the normal case — the gateway verifies
# authorizations itself by simulating the transfer and settles them directly.
X402_FACILITATOR_URL=
X402_FACILITATOR_KEY=

# ── x402 settlement (EIP-3009) ────────────────────────────────────────────
# X402Settler: one transaction that pulls the buyer's signed authorization, takes the protocol
# fee, pays the seller and anchors the co-signed receipt. Unset → 2-tx "direct" mode, no fee.
X402_SETTLER_ADDRESS=0x630b7C9D965994A3F2a2254534260A67423B6672
# Protocol fee in basis points. 0 = off (the deployed default). Hard-capped at 500 (5%) in the
# contract, so not even the owner can raise it further.
TIAGOH_FEE_BPS=0
TIAGOH_TREASURY=
# Only allowlisted operators may call settleBare (the path for standard x402 clients, which
# produce no tiagoh receipt signatures and therefore nothing binding the payee).
GATEWAY_OPERATOR=
MAX_SETTLEMENT=5000000

# ── The three keys, and what each is allowed to do ────────────────────────
# Generate fresh ones with `cast wallet new`. NEVER commit a real key.
#   BUYER  signs payment authorizations. Needs USDC.e and NO native gas at all.
#   SELLER co-signs receipts as payee and receives the money. Sends no transactions, so it
#          needs no gas — and a payout address whose nonce stays 0 is the cleanest answer to
#          "is this wash traffic?".
#   PRIVATE_KEY (submitter/recorder) relays transactions. Needs BTC gas, holds no money.
BUYER_PRIVATE_KEY=
TIAGOH_SELLER_KEY=
# COMPOSER_KEY funds a composite tool that buys its own sub-tools (the cascade). Optional.
COMPOSER_KEY=

# ── e2e / on-chain settle ─────────────────────────────────────────────────
# TIAGOH_ONCHAIN=1 + PRIVATE_KEY makes `pnpm --filter @tiagoh/e2e demo` anchor real receipts.
TIAGOH_ONCHAIN=0
PRIVATE_KEY=
TIAGOH_MAX_SESSION=5

# ── Deployed tiagoh contracts (filled after `forge script` deploy) ─────────
RECEIPT_REGISTRY_ADDRESS=
REVENUE_SPLIT_ADDRESS=
CASCADE_CONTROLLER_ADDRESS=
PAYMENT_CHANNEL_ADDRESS=
QUALITY_BOND_ADDRESS=
ESCROW_VAULT_ADDRESS=
DISPUTE_ARBITER_ADDRESS=
REPUTATION_SCORER_ADDRESS=
TOOL_AUCTION_ADDRESS=
AGENT_REGISTRY_ADDRESS=

# ── ERC-8004 registries on GOAT (reuse the canonical deployment) ───────────
ERC8004_IDENTITY_REGISTRY=0x8004...
ERC8004_REPUTATION_REGISTRY=0x8004...
ERC8004_VALIDATION_REGISTRY=0x8004...

# ── Legacy gateway signer (superseded by TIAGOH_SELLER_KEY above) ──────────
TIAGOH_PRIVATE_KEY=
TIAGOH_PAY_TO=

# ── Governance / mainnet hardening (see docs/SECURITY.md) ──────────────────
# GOVERNANCE = the Safe multisig or TimelockController that owns the contracts.
# Live on GOAT mainnet: TimelockController 0x14a19a0204a789F5fE1Eb498902D02ec5a8C08AB (6h delay).
GOVERNANCE=0x14a19a0204a789F5fE1Eb498902D02ec5a8C08AB
MIN_DELAY=21600
TIMELOCK_PROPOSER=
TIMELOCK_EXECUTOR=0x0000000000000000000000000000000000000000
# BitVM2 optimistic arbiter config (authorize on bond/escrow only after the verifier is proven).
BITVM2_ARBITER_ADDRESS=
BITVM2_VERIFIER_ADDRESS=
PROPOSAL_BOND=1000000000
CHALLENGE_WINDOW=86400

# ── Autonomous buyer (Claude) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
TIAGOH_AGENT_LIVE=0

# ── Dashboard (client-side, no backend) ────────────────────────────────────
NEXT_PUBLIC_GOAT_CHAIN_ID=2345
NEXT_PUBLIC_GOAT_RPC_URL=https://rpc.goat.network
NEXT_PUBLIC_GOAT_EXPLORER_URL=https://explorer.goat.network

# ── Hosted MCP paywall (apps/dashboard) ────────────────────────────────────
# Charging stays OFF until all five are set: a paywall that cannot settle is worse than a free
# endpoint, because the caller believes they paid. Set these in the Vercel project settings.
#   TIAGOH_CHALLENGE_SECRET  signs the stateless 402 challenges (any long random string)
#   TIAGOH_SUBMITTER_KEY     relays settlements; needs BTC gas, holds no money
#   TIAGOH_PAY_TO            the seller address named on receipts
TIAGOH_CHALLENGE_SECRET=
TIAGOH_SUBMITTER_KEY=
